<?xml version="1.0"?>
<!-- Gazebo Fortress additions for the R2: friction, joint states, ground truth, the Ackermann drive,
     and the Phase 1 test rig. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="r2_gazebo" params="test_actuators">

    <!-- Rubber tyres grip. The chassis keeps Gazebo's default friction: its collisions are
         merged into base_footprint, and sdformat drops <gazebo reference> tags on merged collisions. -->
    <xacro:macro name="tyre" params="link">
      <gazebo reference="${link}">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
      </gazebo>
    </xacro:macro>
    <xacro:tyre link="back_left_link"/>
    <xacro:tyre link="back_right_link"/>
    <xacro:tyre link="front_left_wheel"/>
    <xacro:tyre link="front_right_wheel"/>

    <gazebo>
      <!-- Publishes every joint; the launch file bridges it to /joint_states -->
      <plugin filename="ignition-gazebo-joint-state-publisher-system"
              name="ignition::gazebo::systems::JointStatePublisher">
        <topic>/model/r2/joint_states</topic>
      </plugin>

      <!-- Ground-truth pose, for tests and for judging odometry later. Never feeds the robot's own estimate. -->
      <plugin filename="ignition-gazebo-odometry-publisher-system"
              name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_topic>/model/r2/ground_truth</odom_topic>
        <tf_topic>/model/r2/ground_truth/tf</tf_topic>
        <odom_publish_frequency>50</odom_publish_frequency>
        <dimensions>3</dimensions>
      </plugin>
    </gazebo>

    <!-- Drive: /cmd_vel (linear.x m/s, angular.z rad/s) in, wheel odometry out.
         Geometry comes from r2.urdf.xacro. The odometry is worked out from the rear wheel
         joints and the steering angle, like the real base_node_R2, so it drifts like real odometry.
         The launch file bridges it to /odom_raw; its TF is only bridged when asked for, because
         on the real robot the EKF owns odom -> base_footprint. -->
    <xacro:unless value="${test_actuators}">
      <gazebo>
        <plugin filename="ignition-gazebo-ackermann-steering-system"
                name="ignition::gazebo::systems::AckermannSteering">
          <left_joint>back_left_joint</left_joint>
          <right_joint>back_right_joint</right_joint>
          <left_steering_joint>front_left_steer_joint</left_steering_joint>
          <right_steering_joint>front_right_steer_joint</right_steering_joint>
          <wheel_base>${steer_x - rear_x}</wheel_base>
          <wheel_separation>${2 * rear_y}</wheel_separation>
          <kingpin_width>${2 * steer_y}</kingpin_width>
          <wheel_radius>${wheel_radius}</wheel_radius>
          <steering_limit>${steer_limit}</steering_limit>
          <!-- The real driver clamps to 1.0 m/s (Ackman_driver_R2 xlinear_limit); acceleration not yet measured -->
          <max_velocity>${max_speed}</max_velocity>
          <min_velocity>${-max_speed}</min_velocity>
          <max_acceleration>${max_accel}</max_acceleration>
          <min_acceleration>${-max_accel}</min_acceleration>
          <topic>/model/r2/cmd_vel</topic>
          <odom_topic>/model/r2/odometry</odom_topic>
          <tf_topic>/model/r2/odometry/tf</tf_topic>
          <frame_id>odom</frame_id>
          <child_frame_id>base_footprint</child_frame_id>
          <odom_publish_frequency>50</odom_publish_frequency>
        </plugin>
      </gazebo>
    </xacro:unless>

    <!-- Phase 1 test rig: drive each joint directly, instead of the Ackermann plugin.
         Off by default. -->
    <xacro:if value="${test_actuators}">
      <xacro:macro name="wheel_speed" params="joint">
        <gazebo>
          <plugin filename="ignition-gazebo-joint-controller-system"
                  name="ignition::gazebo::systems::JointController">
            <joint_name>${joint}</joint_name>
            <topic>/model/r2/test/${joint}/cmd_vel</topic>
          </plugin>
        </gazebo>
      </xacro:macro>
      <xacro:wheel_speed joint="back_left_joint"/>
      <xacro:wheel_speed joint="back_right_joint"/>

      <xacro:macro name="steer_angle" params="joint">
        <gazebo>
          <plugin filename="ignition-gazebo-joint-position-controller-system"
                  name="ignition::gazebo::systems::JointPositionController">
            <joint_name>${joint}</joint_name>
            <topic>/model/r2/test/${joint}/cmd_pos</topic>
            <use_velocity_commands>true</use_velocity_commands>
            <p_gain>10</p_gain>
            <cmd_max>3</cmd_max>
            <cmd_min>-3</cmd_min>
          </plugin>
        </gazebo>
      </xacro:macro>
      <xacro:steer_angle joint="front_left_steer_joint"/>
      <xacro:steer_angle joint="front_right_steer_joint"/>
    </xacro:if>

  </xacro:macro>
</robot>
