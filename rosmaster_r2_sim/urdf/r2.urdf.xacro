<?xml version="1.0"?>
<!--
  Simulation model of the Yahboom Rosmaster R2.

  Frames, joint names and joint poses copy yahboomcar_description/urdf/yahboomcar_R2.urdf.xacro,
  so the TF tree matches the real robot. Visuals reuse Yahboom's meshes from that package.
  What is different from Yahboom's model, and why, is listed in docs/research/01-phase1-model.md:
    - simple collision shapes instead of full-detail meshes
    - all four wheel axes are +Y, so a positive wheel speed always rolls forward
    - no toe on the front wheels (Yahboom's had ~0.6 deg, both pointing right)
    - real masses and inertias for the steering links and the lidar
    - Gazebo friction and plugins (r2.gazebo.xacro)
-->
<robot name="yahboomcar_R2" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="test_actuators" default="false"/>

  <xacro:property name="mesh" value="package://yahboomcar_description/meshes"/>

  <!-- Geometry, measured from Yahboom's model (docs/research/00-system-survey.md §2) -->
  <xacro:property name="wheel_radius" value="0.0345"/>
  <xacro:property name="wheel_width" value="0.0265"/>
  <xacro:property name="wheel_mass" value="0.060236"/>
  <xacro:property name="rear_x" value="-0.11607"/>
  <xacro:property name="rear_y" value="0.08425"/>
  <xacro:property name="rear_z" value="0.0125"/>
  <xacro:property name="steer_x" value="0.11922"/>
  <xacro:property name="steer_y" value="0.065"/>
  <xacro:property name="steer_limit" value="0.6"/>
  <xacro:property name="steer_mass" value="0.02"/>

  <!-- Masses not yet measured on the real robot (survey §7, question 1).
       Chassis and camera are Yahboom's CAD values; the lidar is an estimate. -->
  <xacro:property name="chassis_mass" value="0.52447"/>
  <xacro:property name="camera_mass" value="0.22414"/>
  <xacro:property name="lidar_mass" value="0.1"/>

  <xacro:macro name="cylinder_inertial" params="mass radius length">
    <!-- Cylinder with its axis along +Y (a wheel) -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (3 * radius * radius + length * length) / 12}" ixy="0" ixz="0"
               iyy="${mass * radius * radius / 2}" iyz="0"
               izz="${mass * (3 * radius * radius + length * length) / 12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertial" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (y * y + z * z) / 12}" ixy="0" ixz="0"
               iyy="${mass * (x * x + z * z) / 12}" iyz="0"
               izz="${mass * (x * x + y * y) / 12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel" params="name">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh}/back_right_link.STL"/></geometry>
        <material name="wheel_grey"><color rgba="0.79216 0.81961 0.93333 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertial mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}"/>
    </link>
  </xacro:macro>

  <xacro:macro name="steer" params="name">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh}/front_left_steer.STL"/></geometry>
        <material name="steer_green"><color rgba="0.082353 0.56078 0 1"/></material>
      </visual>
      <!-- No collision: the steering knuckle sits inside the wheel -->
      <xacro:box_inertial mass="${steer_mass}" x="0.03" y="0.02" z="0.025">
        <origin xyz="0 0 -0.013" rpy="0 0 0"/>
      </xacro:box_inertial>
    </link>
  </xacro:macro>

  <!-- ===== Root and chassis ===== -->

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.0215" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh}/base_link.STL"/></geometry>
      <material name="chassis_green"><color rgba="0 0.62745 0.23529 1"/></material>
    </visual>
    <!-- Lower deck: between the axles, above the wheel bottoms (2 cm ground clearance) -->
    <collision name="deck">
      <origin xyz="0.0 0 0.035" rpy="0 0 0"/>
      <geometry><box size="0.30 0.13 0.05"/></geometry>
    </collision>
    <!-- Upper deck carrying the Jetson and the lidar -->
    <collision name="upper_deck">
      <origin xyz="-0.02 0 0.085" rpy="0 0 0"/>
      <geometry><box size="0.22 0.15 0.05"/></geometry>
    </collision>
    <inertial>
      <!-- Yahboom's CAD values -->
      <origin xyz="-0.014025 -0.00011707 0.082168" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia ixx="0.00066245" ixy="-3.1852E-08" ixz="-4.6503E-05"
               iyy="0.0012486" iyz="-3.356E-08" izz="0.0018052"/>
    </inertial>
  </link>

  <!-- ===== Rear wheels (driven) ===== -->

  <xacro:wheel name="back_left_link"/>
  <joint name="back_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="back_left_link"/>
    <origin xyz="${rear_x} ${rear_y} ${rear_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <xacro:wheel name="back_right_link"/>
  <joint name="back_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="back_right_link"/>
    <origin xyz="${rear_x} ${-rear_y} ${rear_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ===== Front wheels (steered) ===== -->

  <xacro:steer name="front_left_steer"/>
  <joint name="front_left_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steer"/>
    <origin xyz="${steer_x} ${steer_y} 0.0262" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-steer_limit}" upper="${steer_limit}" effort="10" velocity="3"/>
  </joint>

  <xacro:wheel name="front_left_wheel"/>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steer"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.00022897 0.0228 -0.0141" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <xacro:steer name="front_right_steer"/>
  <joint name="front_right_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_steer"/>
    <origin xyz="${steer_x} ${-steer_y} 0.0242" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-steer_limit}" upper="${steer_limit}" effort="10" velocity="3"/>
  </joint>

  <xacro:wheel name="front_right_wheel"/>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steer"/>
    <child link="front_right_wheel"/>
    <origin xyz="-0.00025662 -0.019549 -0.0121" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ===== Sensors (mounts only; the Gazebo sensors come in Phase 3) ===== -->

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh}/camera_link.STL"/></geometry>
      <material name="camera_black"><color rgba="0.082353 0.082353 0.082353 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <geometry><box size="0.04 0.165 0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0022507 -5.8908E-06 -0.021168" rpy="0 0 0"/>
      <mass value="${camera_mass}"/>
      <inertia ixx="0.00039172" ixy="2.2482E-08" ixz="4.3677E-08"
               iyy="4.6625E-05" iyz="1.3858E-10" izz="0.0004106"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.095117 0 0.09955" rpy="0 0.0057171 0"/>
  </joint>

  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh}/laser_link.STL"/></geometry>
      <material name="lidar_white"><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
    </collision>
    <xacro:box_inertial mass="${lidar_mass}" x="0.07" y="0.07" z="0.04">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:box_inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.012548 0 0.1311" rpy="0 0 3.1416"/>
  </joint>

  <link name="imu_link"/>
  <joint name="base_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.05 0.0 0.05" rpy="0 3.1415 1.5707"/>
  </joint>

  <xacro:include filename="$(find rosmaster_r2_sim)/urdf/r2.gazebo.xacro"/>
  <xacro:r2_gazebo test_actuators="$(arg test_actuators)"/>

</robot>
